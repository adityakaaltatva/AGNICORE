# Example environment configuration for AGNICORE
# Copy this file to .env and fill in your own secrets

# JWT Secret - Generate a strong secret using:
#   openssl rand -base64 32
JWT_SECRET=your_strong_random_secret_here_min_32_chars

# Enable developer token issuer (set to false in production)
ENABLE_DEV_TOKEN_ISSUER=false

# Admin secret for developer token issuer
# Generate a strong secret using:
#   openssl rand -base64 32
TOKEN_ISSUER_ADMIN_SECRET=your_strong_admin_secret_here

# Database URL
DATABASE_URL=sqlite:./agnicore.db?mode=rwc

# Server port
PORT=8080

# Allowed CORS origins (comma-separated)
# In production, restrict to your frontend domain:
#   ALLOWED_ORIGINS=https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173